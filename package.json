{
  "name": "frankencoin-dapp",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "next build",
    "dev": "yarn install && next dev",
    "dev3000": "yarn install && next dev -p 3000",
    "export": "next export",
    "start": "next start",
    "lint": "next lint",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "prettier-watch": "onchange \"**/*\" -- prettier --write --ignore-unknown {{changed}}",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@apollo/client": "^3.8.0",
    "@coinbase/wallet-sdk": "^4.3.6",
    "@ethersproject/units": "^5.7.0",
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-brands-svg-icons": "^6.4.2",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@frankencoin/api": "^0.3.15",
    "@frankencoin/zchf": "^0.3.21",
    "@metamask/connect-evm": "^1.0.0",
    "@opennextjs/cloudflare": "^1.19.5",
    "@reduxjs/toolkit": "^2.2.5",
    "@reown/appkit": "^1.8.19",
    "@reown/appkit-adapter-wagmi": "^1.8.19",
    "@tanstack/react-query": "^5.100.5",
    "@types/node": "18.11.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@walletconnect/ethereum-provider": "^2.21.1",
    "abitype": "^0.9.6",
    "apexcharts": "^4.0.0",
    "axios": "^1.6.2",
    "coingecko-api-v3": "^0.0.29",
    "dayjs": "^1.11.9",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.15",
    "graphql": "^16.8.1",
    "next": "^15.5.15",
    "next-seo": "^5.15.0",
    "porto": "^0.2.37",
    "react": "^19",
    "react-apexcharts": "^1.4.1",
    "react-datepicker": "^6.1.0",
    "react-dom": "^19",
    "react-qr-code": "^2.0.15",
    "react-redux": "^9.1.2",
    "react-select": "^5.8.0",
    "react-to-pdf": "^2.0.0",
    "react-toastify": "^9.1.3",
