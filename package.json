  "devDependencies": {
    "@babel/core": "^7.20.5",
    "@types/react-datepicker": "^6.2.0",
    "autoprefixer": "^10.4.14",
    "babel-loader": "^8.3.0",
    "flowbite": "^2.3.0",
    "flowbite-datepicker": "^1.2.6",
    "flowbite-react": "^0.7.3",
    "postcss": "^8.4.19",
    "prettier": "^2.8.1",
    "tailwindcss": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.87.0"
